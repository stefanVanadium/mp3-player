(version 1)

# Board Setup minimum is 0.2 mm so the rules below can use it; everything
# else keeps 0.3 mm.
(rule "Edge clearance"
	(constraint edge_clearance (min 0.3mm)))

# Sinking USB-C and jack sit in board cutouts, so their pads are close to the
# routed edge by design. JLC accepts 0.2 mm copper to a routed edge.
(rule "Sinking connectors edge clearance"
	(constraint edge_clearance (min 0.2mm))
	(condition "A.Type == 'Pad' && (A.Parent.Reference == 'USB1' || A.Parent.Reference == 'CN1')"))
